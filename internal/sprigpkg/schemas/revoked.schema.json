{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thicket.dev/schemas/gallery/revoked.schema.json",
  "title": "Gallery repository revoked.json (kept by moderators)",
  "type": "object",
  "additionalProperties": false,
  "required": ["revoked"],
  "properties": {
    "revoked": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "reason", "revoked_at"],
        "properties": {
          "key_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
          "reason": {"type": "string", "maxLength": 200},
          "revoked_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
        }
      }
    }
  }
}
