{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thicket.dev/schemas/gallery/skill.schema.json",
  "title": "Gallery sprig skills/*.md front matter",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "description": {"type": "string", "minLength": 1, "maxLength": 200},
    "inputs": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$"},
          "description": {"type": "string", "maxLength": 200},
          "required": {"type": "boolean"}
        }
      }
    },
    "success_check": {"type": "string", "maxLength": 300}
  }
}
